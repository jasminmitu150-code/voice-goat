# =============================================================================
# VoiceGoat Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have sensible defaults for local development with mock mode.
# Only OPENAI_API_KEY is required if you switch to LLM_PROVIDER=openai.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Options: mock (default, free), openai, bedrock
LLM_PROVIDER=mock

# Override the default model for your chosen provider
# LLM_MODEL=
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# OpenAI (required when LLM_PROVIDER=openai)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=              # Leave empty for OpenAI; set for compatible APIs (e.g. Ollama)

# -----------------------------------------------------------------------------
# AWS / Bedrock (required when LLM_PROVIDER=bedrock or for speech features)
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# -----------------------------------------------------------------------------
# Speech (AWS Transcribe / Polly)
# -----------------------------------------------------------------------------
# SPEECH_MODE=text              # Options: text (default), speech, both
# TRANSCRIBE_LANGUAGE_CODE=en-US
# TRANSCRIBE_SAMPLE_RATE=16000
# POLLY_VOICE_ID=Joanna
# POLLY_ENGINE=neural

# -----------------------------------------------------------------------------
# Twilio (optional, for voice gateway phone integration)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token

# -----------------------------------------------------------------------------
# Infrastructure (defaults work with docker-compose)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379
# OPENSEARCH_ENDPOINT=http://opensearch:9200
# DB_CONNECTION_STRING=postgresql://admin:admin@postgres:5432/voicegoat

# -----------------------------------------------------------------------------
# Security (intentionally weak defaults for training)
# -----------------------------------------------------------------------------
# SECRET_KEY=voicegoat-insecure-secret-key-change-me
# CORS_ORIGINS=["*"]
